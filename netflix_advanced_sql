----12)Find the top 5 directors who have directed the highest number of Netflix movies, along with the total number of movies and the latest release year of each director.

WITH director_data AS (
    SELECT
        n.show_id,
        n.title,
        n.release_year,
        TRIM(director_name) AS director
    FROM netflix_titles n
    JOIN JSON_TABLE(
        CONCAT(
            '["',
            REPLACE(
                REPLACE(n.director, '"', '\\"'),
                ', ',
                '","'
            ),
            '"]'
        ),
        '$[*]' COLUMNS (
            director_name VARCHAR(255) PATH '$'
        )
    ) AS d
    WHERE n.type = 'Movie'
      AND n.director IS NOT NULL
      AND TRIM(n.director) <> ''
      AND LOWER(TRIM(n.director)) <> 'not given'
)

SELECT
    director,
    COUNT(DISTINCT show_id) AS total_movies,
    MAX(release_year) AS latest_release_year
FROM director_data
GROUP BY director
ORDER BY total_movies DESC
LIMIT 5;

-- 13)Find the latest movie for each release year

WITH ranked_movies AS (
    SELECT
        title,
        release_year,
        ROW_NUMBER() OVER (
            PARTITION BY release_year
            ORDER BY release_year DESC, title
        ) AS row_num
    FROM netflix_titles
    WHERE type = 'Movie'
)
SELECT
    title, 
     release_year
FROM ranked_movies
WHERE row_num = 1
ORDER BY release_year DESC;

-- 14)Rank countries based on the number of Netflix titles

WITH country_counts AS (
    SELECT
        country,
        COUNT(*) AS total_titles
    FROM netflix_titles
    WHERE country IS NOT NULL
      AND TRIM(country) <> ''
    GROUP BY country
)
SELECT
    country,
    total_titles,
    DENSE_RANK() OVER (
        ORDER BY total_titles DESC
    ) AS country_rank
FROM country_counts
ORDER BY country_rank
LIMIT 10;

-- 15)Compare Netflix content added each year with the previous year

WITH yearly_content AS (
    SELECT
        YEAR(STR_TO_DATE(date_added, '%M %d, %Y')) AS year_added,
        COUNT(*) AS total_content
    FROM netflix_titles
    WHERE date_added IS NOT NULL
      AND TRIM(date_added) <> ''
    GROUP BY YEAR(STR_TO_DATE(date_added, '%M %d, %Y'))
)
SELECT
    year_added,
    total_content,
    LAG(total_content) OVER (
        ORDER BY year_added
    ) AS previous_year_content
FROM yearly_content
ORDER BY year_added;

-- 16)Categorize movies based on duration

SELECT
    title,
    duration,
    CASE
        WHEN CAST(SUBSTRING_INDEX(duration, ' ', 1) AS UNSIGNED) < 60
            THEN 'Short'
        WHEN CAST(SUBSTRING_INDEX(duration, ' ', 1) AS UNSIGNED) <= 120
            THEN 'Medium'
        ELSE 'Long'
    END AS duration_category
FROM netflix_titles
WHERE type = 'Movie'
  AND duration IS NOT NULL;
  
